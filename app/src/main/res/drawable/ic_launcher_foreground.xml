<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- 极简现代钟表 (钟/表) 前景矢量图 -->
    <group
        android:translateX="0"
        android:translateY="0">
        
        <!-- 顶部表冠 / 挂环 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#DDDDDD"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M 48,27 C 48,23 60,23 60,27"/>
        
        <!-- 顶部表钮柱 -->
        <path
            android:fillColor="#EEEEEE"
            android:pathData="M 52,27 H 56 V 30 H 52 Z"/>

        <!-- 钟表外圆环表壳 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:pathData="M 54,31 A 24,24 0 1,1 53.99,31 Z"/>

        <!-- 四方刻度线 (12点、3点、6点、9点) -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#CCCCCC"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:pathData="M 54,35 L 54,39
                             M 54,71 L 54,75
                             M 35,55 L 39,55
                             M 71,55 L 75,55"/>

        <!-- 时针 (指向 10 点，短而坚实，代表定力与正念) -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:pathData="M 54,55 L 44,45"/>

        <!-- 分针 (指向 2 点，修长优雅，与时针形成经典的 10:10 舒展微笑姿态) -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFD54F"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:pathData="M 54,55 L 67,45"/>

        <!-- 中心圆轴心 (金色微点缀) -->
        <path
            android:fillColor="#FFD54F"
            android:pathData="M 54,52.5 A 2.5,2.5 0 1,1 53.99,52.5 Z"/>
    </group>
</vector>
