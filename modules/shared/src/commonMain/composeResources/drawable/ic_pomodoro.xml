<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    <!-- 极简纯白实心圆形钟表底盘 (整块白底) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 100,22 A 78,78 0 1,0 100,178 A 78,78 0 1,0 100,22 Z" />

    <!-- 黑色时针 (指向 10 点方向，坚实稳重) -->
    <path
        android:strokeColor="#111111"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M 100,100 L 64,78" />

    <!-- 黑色分针 (指向 2 点方向，修长舒展) -->
    <path
        android:strokeColor="#111111"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M 100,100 L 152,70" />

    <!-- 中心黑色轴点 -->
    <path
        android:fillColor="#111111"
        android:pathData="M 100,94 A 6,6 0 1,0 100,106 A 6,6 0 1,0 100,94 Z" />
</vector>
